{
  "$schema": "https://raw.githubusercontent.com/wzf1997/delivery-harness/main/schemas/evidence.schema.json",
  "schemaVersion": 1,
  "version": "v0.8.0",
  "documents": [
    {
      "documentId": "ai-form-event-js-execution-prd",
      "requirementIds": [
        "fr-1-constrained-generation",
        "fr-2-static-guard",
        "fr-3-real-render-apply-gate",
        "fr-4-merge-overwrite",
        "fr-5-catalog-write-policy",
        "fr-6-frontend-flow"
      ]
    },
    {
      "documentId": "ai-form-event-js-execution-design",
      "requirementIds": [
        "td-event-state-machine",
        "td-event-js-guard",
        "td-preview-execution",
        "td-merge-catalog-routing",
        "td-regression-contracts"
      ]
    }
  ],
  "requirements": [
    {
      "id": "fr-1-constrained-generation",
      "description": "同一 /event 端点从 EventSpec 生成受约束纯前端事件 JS，公式可表达时仍优先 /refine formula",
      "caseIds": [
        "event-generate-onchange-preview",
        "event-formula-still-preferred",
        "event-codegen-dispatch-by-event-key"
      ]
    },
    {
      "id": "fr-2-static-guard",
      "description": "AST 与符号白名单拒绝网络、动态执行、DOM、定时器及未知字段引用",
      "caseIds": [
        "event-guard-forbid-network",
        "event-guard-forbid-eval-dom-timer",
        "event-guard-unknown-field-ref"
      ]
    },
    {
      "id": "fr-3-real-render-apply-gate",
      "description": "无全绿 executionReport 不得 applied；服务端以 actual 对照 expect 重判；真实 VForm 覆盖联动、点击、生命周期、子表行及表单校验",
      "caseIds": [
        "event-apply-without-report-rejected",
        "event-apply-failed-report-draft",
        "event-apply-forged-ok-rejected",
        "event-compute-onchange-apply",
        "event-linkage-set-enable-apply",
        "event-show-hide-condition-apply",
        "event-button-onclick-open-dialog",
        "event-created-mounted-apply",
        "event-subform-row-apply",
        "event-form-validate-submit-guard"
      ]
    },
    {
      "id": "fr-4-merge-overwrite",
      "description": "仅 applied 合入允许键；已有手写代码须显式确认；/refine 继续禁写事件",
      "caseIds": [
        "event-compute-onchange-apply",
        "event-existing-handwritten-overwrite-or-reject",
        "event-refine-still-forbids-events"
      ]
    },
    {
      "id": "fr-5-catalog-write-policy",
      "description": "纯前端事件及 functions 在 event apply 路径可写，接口与危险类仍拒绝，shape 覆盖完整",
      "caseIds": [
        "event-allowlist-covers-pure-frontend",
        "event-dialog-allowed-vs-danger",
        "catalog-full-strict-sweep"
      ]
    },
    {
      "id": "fr-6-frontend-flow",
      "description": "前端提供生成、预览验证及确认写入闸，验证前或验证失败时不得写入画布",
      "caseIds": [
        "event-ui-apply-gate",
        "event-ui-verify-rejects-mismatch",
        "event-compute-onchange-apply"
      ]
    },
    {
      "id": "td-event-state-machine",
      "description": "/event 支持 clarify、generate/code_preview、apply/applied/draft 状态机并校验报告明细",
      "caseIds": [
        "event-generate-onchange-preview",
        "event-apply-without-report-rejected",
        "event-apply-failed-report-draft",
        "event-apply-forged-ok-rejected",
        "event-compute-onchange-apply"
      ]
    },
    {
      "id": "td-event-js-guard",
      "description": "eventJsGuard 在生成及合入前执行 AST、API、字段引用和危险构造校验",
      "caseIds": [
        "event-guard-forbid-network",
        "event-guard-forbid-eval-dom-timer",
        "event-guard-unknown-field-ref"
      ]
    },
    {
      "id": "td-preview-execution",
      "description": "候选 JSON 在真实 VFormRender preview/render 中触发并生成 executionReport",
      "caseIds": [
        "event-compute-onchange-apply",
        "event-linkage-set-enable-apply",
        "event-show-hide-condition-apply",
        "event-button-onclick-open-dialog",
        "event-created-mounted-apply",
        "event-subform-row-apply",
        "event-form-validate-submit-guard",
        "event-ui-apply-gate",
        "event-ui-verify-rejects-mismatch"
      ]
    },
    {
      "id": "td-merge-catalog-routing",
      "description": "事件补丁隔离合入，Catalog 按 event/refine 路由分流并保护已有手写代码",
      "caseIds": [
        "event-existing-handwritten-overwrite-or-reject",
        "event-dialog-allowed-vs-danger",
        "event-refine-still-forbids-events",
        "event-allowlist-covers-pure-frontend"
      ]
    },
    {
      "id": "td-regression-contracts",
      "description": "v0.7 澄清、v0.6 重型容器、严格目录扫描及前端无密钥保持回归通过",
      "caseIds": [
        "event-v07-clarify-regression",
        "refine-v06-regression",
        "catalog-full-strict-sweep",
        "frontend-no-secret"
      ]
    }
  ],
